APP_NAME=KeyCompare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Set this to a random string to require API auth on /api/import
# Generate with: openssl rand -hex 32
IMPORT_API_TOKEN=

# Optional: convert prices to a target currency (USD, EUR, etc.). Leave blank to store as-is.
TARGET_CURRENCY=
EXCHANGE_RATE_API_KEY=
